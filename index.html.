          <li><a href="menu.html">Menu</a></li>
          <li><a href="tietoja.html">Tietoja</a></li>
          <li><a href="yhteystiedot.html">Yhteystiedot</a></li>
          <li><a href="results.html">Results</a></li>
        </ul>
      </nav>
